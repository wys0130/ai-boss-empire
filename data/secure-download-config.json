{
  "version": "1.0.0",
  "name": "Secure Download System",
  "description": "3-minute expiry presigned download links with Ed25519 signature",
  "config": {
    "expirySeconds": 180,
    "maxDownloadsPerOrder": 1,
    "signatureAlgorithm": "Ed25519",
    "storageType": "localStorage",
    "vipAccessDays": 7
  },
  "endpoints": {
    "generateLink": "/api/generate-download-link",
    "verifyLink": "/api/verify-download-link",
    "downloadFile": "/assets/templates/{productId}/download"
  },
  "security": {
    "antiHotlink": true,
    "singleUse": true,
    "expiryEnabled": true,
    "signatureRequired": true,
    "encryptionEnabled": true
  },
  "integration": {
    "paymentProviders": ["stripe", "paypal", "lemonsqueezy", "paddle"],
    "callbackEvents": ["payment:success", "PAYMENT_SUCCESS"],
    "storageKeys": {
      "activeLinks": "apexwork_secure_downloads",
      "vipAccess": "apexwork_vip",
      "stats": "apexwork_download_stats"
    }
  },
  "ui": {
    "countdownEnabled": true,
    "autoDownload": false,
    "showOrderId": true,
    "showAmount": true,
    "showExpiryWarning": true
  }
}