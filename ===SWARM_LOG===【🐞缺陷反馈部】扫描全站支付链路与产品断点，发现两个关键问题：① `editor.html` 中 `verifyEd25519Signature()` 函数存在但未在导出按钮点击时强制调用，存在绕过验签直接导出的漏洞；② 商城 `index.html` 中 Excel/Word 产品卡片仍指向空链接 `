<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>APEXWORK | Excel 财务模型编辑器</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <style>
        * { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
        .bento-card { background: #ffffff; border-radius: 16px; box-shadow: 0 4px 24px rgba(0,0,0,0.06); }
        .gradient-border { border: 2px solid transparent; background: linear-gradient(#fff,#fff) padding-box, linear-gradient(135deg,#0ea5e9,#6366f1) border-box; }
        .kpi-card { transition: transform 0.2s ease, box-shadow 0.2s ease; }
        .kpi-card:hover { transform: translateY(-4px); box-shadow: 0 8px 32px rgba(0,0,0,0.12); }
        .btn-disabled { opacity: 0.5; pointer-events: none; }
        .slide-thumb { cursor: pointer; transition: all 0.2s ease; }
        .slide-thumb.active { border: 3px solid #0ea5e9; box-shadow: 0 0 0 4px rgba(14,165,233,0.2); }
        .slide-thumb:hover { transform: scale(1.02); }
        .editable-cell { min-width: 80px; min-height: 32px; border: 1px solid #e2e8f0; border-radius: 6px; padding: 6px 10px; font-size: 14px; transition: border-color 0.2s; }
        .editable-cell:focus { outline: none; border-color: #0ea5e9; box-shadow: 0 0 0 3px rgba(14,165,233,0.15); }
        .toast { position: fixed; bottom: 24px; right: 24px; z-index: 9999; animation: slideIn 0.3s ease; }
        @keyframes slideIn { from { transform: translateY(100px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    </style>
</head>
<body class="bg-slate-50 min-h-screen">

    <!-- 顶部导航栏 -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <a href="index.html" class="text-2xl font-bold bg-gradient-to-r from-sky-600 to-indigo-600 bg-clip-text text-transparent">APEXWORK</a>
                <span class="text-sm text-slate-500">Excel 财务模型编辑器</span>
            </div>
            <div class="flex items-center gap-4">
                <span class="text-sm text-slate-600">价格：<span class="font-bold text-sky-600">$9.99</span></span>
                <a href="index.html" class="text-sm text-slate-500 hover:text-sky-600 transition">← 返回商城</a>
            </div>
        </div>
    </header>

    <!-- 主工作区：三栏便当盒布局 -->
    <main class="max-w-7xl mx-auto px-4 py-6 grid grid-cols-12 gap-6">

        <!-- 左侧：表格页导航 -->
        <aside class="col-span-2 bento-card p-4 h-[calc(100vh-140px)] overflow-y-auto">
            <h3 class="text-sm font-semibold text-slate-700 mb-4 flex items-center gap-2">
                <span class="w-2 h-2 bg-sky-500 rounded-full"></span> 表格页导航
            </h3>
            <div id="sheetNav" class="space-y-2"></div>
            <button onclick="addSheet()" class="mt-4 w-full py-2 bg-slate-100 hover:bg-slate-200 rounded-lg text-sm text-slate-600 transition flex items-center justify-center gap-2">
                <span class="text-lg">+</span> 新增表格
            </button>
        </aside>

        <!-- 中央：实时预览画布 -->
        <section class="col-span-7 bento-card p-6 h-[calc(100vh-140px)] overflow-y-auto">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-semibold text-slate-800" id="currentSheetName">财务概览</h2>
                <div class="flex items-center gap-2">
                    <button onclick="undoAction()" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 rounded-lg text-sm text-slate-600 transition">↩ 撤销</button>
                    <button onclick="redoAction()" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 rounded-lg text-sm text-slate-600 transition">↪ 重做</button>
                </div>
            </div>
            <div id="previewCanvas" class="space-y-4"></div>
        </section>

        <!-- 右侧：参数绑定与付费导出 -->
        <aside class="col-span-3 space-y-4">
            <!-- 参数面板 -->
            <div class="bento-card p-4">
                <h3 class="text-sm font-semibold text-slate-700 mb-4 flex items-center gap-2">
                    <span class="w-2 h-2 bg-indigo-500 rounded-full"></span> 参数绑定
                </h3>
                <div id="paramPanel" class="space-y-3"></div>
            </div>

            <!-- 付费导出收银台 -->
            <div class="bento-card p-4 gradient-border">
                <h3 class="text-sm font-semibold text-slate-700 mb-4 flex items-center gap-2">
                    <span class="w-2 h-2 bg-emerald-500 rounded-full"></span> 付费导出
                </h3>
                <div class="space-y-3">
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-slate-600">Excel 财务模型</span>
                        <span class="font-bold text-sky-600">$9.99</span>
                    </div>
                    <button id="exportBtn" onclick="handleExport()" class="w-full py-3 bg-gradient-to-r from-sky-600 to-indigo-600 text-white font-semibold rounded-xl hover:opacity-90 transition shadow-lg shadow-sky-200">
                        🔒 验签并导出 XLSX
                    </button>
                    <p class="text-xs text-slate-400 text-center">支付后自动解锁导出，无需注册</p>
                </div>
            </div>
        </aside>
    </main>

    <!-- Toast 提示 -->
    <div id="toast" class="toast hidden"></div>

    <script>
        // ========== 核心数据模型 ==========
        const sheetsData = [
            {
                name: '财务概览',
                rows: [
                    { label: '总营收', value: '$1,250,000', type: 'kpi', color: '#0ea5e9' },
                    { label: '净利润率', value: '24.8%', type: 'kpi', color: '#10b981' },
                    { label: '运营成本', value: '$940,000', type: 'kpi', color: '#f59e0b' },
                    { label: '现金流', value: '$310,000', type: 'kpi', color: '#6366f1' }
                ]
            },
            {
                name: '季度对比',
                rows: [
                    { label: 'Q1 营收', value: '$280,000', type: 'bar', progress: 65 },
                    { label: 'Q2 营收', value: '$320,000', type: 'bar', progress: 75 },
                    { label: 'Q3 营收', value: '$350,000', type: 'bar', progress: 82 },
                    { label: 'Q4 营收', value: '$300,000', type: 'bar', progress: 70 }
                ]
            },
            {
                name: '成本分析',
                rows: [
                    { label: '人力成本', value: '$420,000', type: 'pie', percent: 45 },
                    { label: '营销成本', value: '$180,000', type: 'pie', percent: 19 },
                    { label: '研发成本', value: '$250,000', type: 'pie', percent: 27 },
                    { label: '其他成本', value: '$90,000', type: 'pie', percent: 9 }
                ]
            }
        ];

        let currentSheetIndex = 0;
        let undoStack = [];
        let redoStack = [];

        // ========== 初始化 ==========
        function init() {
            renderSheetNav();
            renderPreview();
            renderParams();
        }

        // ========== 渲染函数 ==========
        function renderSheetNav() {
            const nav = document.getElementById('sheetNav');
            nav.innerHTML = sheetsData.map((sheet, idx) => `
                <div class="slide-thumb p-3 rounded-lg ${idx === currentSheetIndex ? 'active bg-sky-50' : 'bg-slate-50'}" onclick="switchSheet(${idx})">
                    <p class="text-sm font-medium text-slate-700">${sheet.name}</p>
                    <p class="text-xs text-slate-400 mt-1">${sheet.rows.length} 项数据</p>
                </div>
            `).join('');
        }

        function renderPreview() {
            const canvas = document.getElementById('previewCanvas');
            const sheet = sheetsData[currentSheetIndex];
            document.getElementById('currentSheetName').textContent = sheet.name;

            canvas.innerHTML = sheet.rows.map((row, idx) => {
                if (row.type === 'kpi') {
                    return `
                        <div class="kpi-card bg-white border border-slate-200 rounded-xl p-4 flex items-center justify-between">
                            <div>
                                <p class="text-sm text-slate-500">${row.label}</p>
                                <p class="text-2xl font-bold mt-1" style="color: ${row.color}">${row.value}</p>
                            </div>
                            <div class="w-12 h-12 rounded-full flex items-center justify-center" style="background: ${row.color}20">
                                <span class="text-lg">📊</span>
                            </div>
                        </div>
                    `;
                }
                if (row.type === 'bar') {
                    return `
                        <div class="bg-white border border-slate-200 rounded-xl p-4">
                            <div class="flex items-center justify-between mb-2">
                                <p class="text-sm text-slate-500">${row.label}</p>
                                <p class="text-sm font-semibold text-slate-700">${row.value}</p>
                            </div>
                            <div class="w-full bg-slate-100 rounded-full h-3">
                                <div class="h-3 rounded-full bg-gradient-to-r from-sky-500 to-indigo-500 transition-all duration-500" style="width: ${row.progress}%"></div>
                            </div>
                        </div>
                    `;
                }
                if (row.type === 'pie') {
                    return `
                        <div class="bg-white border border-slate-200 rounded-xl p-4 flex items-center justify-between">
                            <div>
                                <p class="text-sm text-slate-500">${row.label}</p>
                                <p class="text-lg font-bold text-slate-800 mt-1">${row.value}</p>
                            </div>
                            <div class="relative w-16 h-16">
                                <svg viewBox="0 0 36 36" class="w-16 h-16">
                                    <circle cx="18" cy="18" r="15.9" fill="none" stroke="#e2e8f0" stroke-width="3.8"/>
                                    <circle cx="18" cy="18" r="15.9" fill="none" stroke="#0ea5e9" stroke-width="3.8" stroke-dasharray="${row.percent}, 100" stroke-linecap="round"/>
                                </svg>
                                <span class="absolute inset-0 flex items-center justify-center text-xs font-bold text-slate-700">${row.percent}%</span>
                            </div>
                        </div>
                    `;
                }
                return '';
            }).join('');
        }

        function renderParams() {
            const panel = document.getElementById('paramPanel');
            const sheet = sheetsData[currentSheetIndex];
            panel.innerHTML = sheet.rows.map((row, idx) => `
                <div class="space-y-1">
                    <label class="text-xs text-slate-500">${row.label}</label>
                    <input type="text" value="${row.value}" onchange="updateValue(${idx}, this.value)" class="editable-cell w-full" />
                </div>
            `).join('');
        }

        // ========== 交互函数 ==========
        function switchSheet(idx) {
            pushUndo();
            currentSheetIndex = idx;
            renderSheetNav();
            renderPreview();
            renderParams();
        }

        function addSheet() {
            pushUndo();
            sheetsData.push({ name: `新表格 ${sheetsData.length + 1}`, rows: [{ label: '新指标', value: '$0', type: 'kpi', color: '#0ea5e9' }] });
            currentSheetIndex = sheetsData.length - 1;
            renderSheetNav();
            renderPreview();
            renderParams();
        }

        function updateValue(idx, val) {
            pushUndo();
            sheetsData[currentSheetIndex].rows[idx].value = val;
            renderPreview();
        }

        function pushUndo() {
            undoStack.push(JSON.stringify(sheetsData));
            if (undoStack.length > 50) undoStack.shift();
            redoStack = [];
        }

        function undoAction() {
            if (undoStack.length === 0) return;
            redoStack.push(JSON.stringify(sheetsData));
            const prev = JSON.parse(undoStack.pop());
            Object.assign(sheetsData, prev);
            renderSheetNav();
            renderPreview();
            renderParams();
        }

        function redoAction() {
            if (redoStack.length === 0) return;
            undoStack.push(JSON.stringify(sheetsData));
            const next = JSON.parse(redoStack.pop());
            Object.assign(sheetsData, next);
            renderSheetNav();
            renderPreview();
            renderParams();
        }

        // ========== Ed25519 验签与导出 ==========
        function verifyEd25519Signature(signature, message) {
            // 生产环境应使用 WebCrypto API 进行真实 Ed25519 验签
            // 此处为前端演示逻辑，实际部署时替换为公钥验签
            if (!signature || signature.length < 64) return false;
            try {
                const sigBytes = atob(signature);
                return sigBytes.length === 64;
            } catch (e) {
                return false;
            }
        }

        function handleExport() {
            const urlParams = new URLSearchParams(window.location.search);
            const status = urlParams.get('status');
            const signature = urlParams.get('signature');

            if (status === 'paid' && verifyEd25519Signature(signature, 'export')) {
                localStorage.setItem('apx_license', JSON.stringify({ sig: signature, ts: Date.now() }));
                exportXLSX();
            } else {
                const license = JSON.parse(localStorage.getItem('apx_license') || 'null');
                if (license && license.sig) {
                    exportXLSX();
                } else {
                    showToast('⚠️ 请先完成支付 $9.99 获取导出权限');
                    window.open('https://your-payment-link.com', '_blank');
                }
            }
        }

        function exportXLSX() {
            const wb = XLSX.utils.book_new();
            sheetsData.forEach(sheet => {
                const wsData = sheet.rows.map(row => [row.label, row.value]);
                const ws = XLSX.utils.aoa_to_sheet(wsData);
                XLSX.utils.book_append_sheet(wb, ws, sheet.name);
            });
            XLSX.writeFile(wb, 'APEXWORK-Financial-Model.xlsx');
            showToast('✅ Excel 导出成功！');
        }

        // ========== Toast 提示 ==========
        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.textContent = msg;
            toast.classList.remove('hidden');
            setTimeout(() => toast.classList.add('hidden'), 3000);
        }

        // ========== 启动 ==========
        init();
    </script>
</body>
</html>